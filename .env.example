# Copy to .env and replace every placeholder. Never commit .env.

# --- Local development / tests (npm run ... in backend/) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ops_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ops_test
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=8h
PORT=4000
BCRYPT_ROUNDS=10

# --- Docker Compose only ---
POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ops
